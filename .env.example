# Postgres (local Docker)
POSTGRES_USER=recall
POSTGRES_PASSWORD=recall
POSTGRES_DB=recall
POSTGRES_PORT=5432

# Redis (local Docker)
REDIS_PORT=6379

# Connection strings used by the apps (Prisma, BullMQ)
DATABASE_URL=postgresql://recall:recall@localhost:5432/recall
REDIS_URL=redis://localhost:6379
# Auth (Better Auth)
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Optional — Google sign-in is enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Observability (optional — Sentry stays off when empty)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=
